{
  "$schema": "./telegram_subscriptions.schema.json",
  "version": 1,
  "subscribers": [
    {
      "chat_id": "${TELEGRAM_CHAT_ID}",
      "name": "Default Subscriber",
      "enabled": true,
      "filters": [
        "egypt_7_10",
        "egypt_13_16",
        "egypt_autumn_2026_7_10",
        "egypt_autumn_2026_13_16",
        "turkey_7_10",
        "turkey_9_11",
        "turkey_13_16"
      ],
      "rules": {
        "deal_score_min": 90,
        "price_drop_pct_min": 15.0,
        "single_run_drop_pct_min": 12.0,
        "max_price_pln": null,
        "min_ta_rating": 3.8,
        "notify_hot_deals": true,
        "notify_price_drops": true,
        "notify_new_historic_low": true,
        "notify_market_summary": true
      },
      "schedule": {
        "mode": "instant",
        "quiet_hours": [23, 0, 1, 2, 3, 4, 5, 6],
        "timezone": "Europe/Warsaw",
        "daily_digest_hour": 9,
        "max_messages_per_hour": 15
      }
    }
  ]
}
